# Copy to .env and adjust. Every setting is optional.

# Where the library database lives, and the folder `bookworm index` scans by default.
BOOKWORM_DB=./bookworm.duckdb
# BOOKWORM_LIBRARY=~/Books
# BOOKWORM_EXCLUDE_DIRS=comics,scans

# Embeddings: hash (built-in, offline), fastembed (local ONNX), openai, openrouter, ollama,
# or openai-compatible with BOOKWORM_EMBED_BASE_URL.
BOOKWORM_EMBEDDER=hash
# BOOKWORM_EMBED_MODEL=text-embedding-3-small
# BOOKWORM_EMBED_BASE_URL=http://localhost:1234/v1
# BOOKWORM_EMBED_API_KEY=

# Grounded answers for `bookworm ask`. Leave unset for extractive answers.
# BOOKWORM_CHAT_PROVIDER=openai
# BOOKWORM_CHAT_MODEL=gpt-4o-mini
# BOOKWORM_CHAT_BASE_URL=
# BOOKWORM_CHAT_API_KEY=

# Provider keys are also read from their usual variables.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Chunking and ranking
# BOOKWORM_CHUNK_TOKENS=320
# BOOKWORM_CHUNK_OVERLAP=64
# BOOKWORM_MMR_LAMBDA=1.0
